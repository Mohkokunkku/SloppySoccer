{
  "name": "sloppy-soccer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "check": "npm run test && npm run build",
    "test:e2e": "playwright test",
    "deploy:local": "tsx scripts/deploy-local.ts",
    "serve:local": "tsx scripts/serve-local.ts",
    "setup:local-cd": "tsx scripts/setup-local-cd.ts",
    "rollback:local": "tsx scripts/rollback-local.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "fastify": "5.12.7",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
